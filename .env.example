# ── Variables d'environnement de la boutique (Next.js) ──────
# Copier en .env.local pour le développement local (valeurs ci-dessous prêtes pour le dev) ;
# en production, saisir ces variables sur Vercel avec les vraies adresses.
# Les variables NEXT_PUBLIC_* sont intégrées au build : redéployer après chaque modification.

# ── Backend API ───────────────────────────────────────────────
# Production : https://<api>/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# ── Adresse publique de la boutique ──────────────────────────
# Canonical, sitemap, robots, Open Graph. Identique au FRONTEND_URL de l'API.
# Production : https://<votre-domaine> (OBLIGATOIRE : aucun domaine n'est codé en dur)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Contact ──────────────────────────────────────────────────
# Coordonnées de secours si les paramètres de l'admin sont injoignables.
# Sans téléphone, le site affiche un numéro factice (+22670000000) ; sans email, l'email est masqué.
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=

# ── Connexion avec Google ────────────────────────────────────
# Même valeur que GOOGLE_CLIENT_ID côté API. Vide = bouton Google masqué.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── Back-office (redirection de /admin) ──────────────────────
# Production : https://admin.<votre-domaine>
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002

# ── Cloudinary (upload depuis le navigateur) ─────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dtie3vgyz
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=useProducts
