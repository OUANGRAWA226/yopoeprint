# ── Variables d'Environnement Next.js (Production) ──────────
# Copier ce fichier en .env.local pour le développement local.

# ── Backend API ───────────────────────────────────────────────
# Dev local :
# NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Production (remplacer par l'URL de votre backend sur Render/Railway) :
NEXT_PUBLIC_API_URL=https://yopoeprint-api.onrender.com/api/v1

# ── Cloudinary (Upload depuis le navigateur) ──────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dtie3vgyz
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=useProducts

# ── SEO & Analytics ───────────────────────────────────────────
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── Vercel (automatiquement défini par Vercel) ────────────────
# VERCEL_URL=yopoeprint.vercel.app
