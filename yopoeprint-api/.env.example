# ── Variables d'Environnement NestJS (Production) ─────────────
# IMPORTANT : Ne jamais committer ce fichier avec de vraies valeurs.
# Copier ce fichier et renommer en .env pour le développement local.

# ── Serveur ──────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# ── Base de Données PostgreSQL ────────────────────────────────
# Render / Railway fourniront une DATABASE_URL complète
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME
# OU séparément :
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASS=your_password
# DB_NAME=yopoeprint

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=REMPLACER_PAR_UNE_CLE_ALEATOIRE_32_CHARS_MINIMUM
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=REMPLACER_PAR_UNE_AUTRE_CLE_ALEATOIRE
JWT_REFRESH_EXPIRATION=30d

# ── Cloudinary (Upload des fichiers) ─────────────────────────
CLOUDINARY_CLOUD_NAME=dtie3vgyz
CLOUDINARY_API_KEY=VOTRE_API_KEY
CLOUDINARY_API_SECRET=VOTRE_API_SECRET

# ── CinetPay (Paiement Mobile Money / Carte) ─────────────────
CINETPAY_API_KEY=VOTRE_APIKEY_CINETPAY
CINETPAY_SITE_ID=VOTRE_SITE_ID_CINETPAY
CINETPAY_SECRET_KEY=VOTRE_CLE_SECRETE_CINETPAY
CINETPAY_BASE_URL=https://api-checkout.cinetpay.com/v2

# ── CORS (Frontend URL) ───────────────────────────────────────
# En production, remplacer par l'URL exacte de votre déploiement Vercel
FRONTEND_URL=https://yopoeprint.vercel.app

# ── Email (Notifications Commandes) ──────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@yopoeprint.com
SMTP_PASS=VOTRE_MOT_DE_PASSE_APPLICATION_GMAIL
EMAIL_FROM=YopoePrint <notifications@yopoeprint.com>
