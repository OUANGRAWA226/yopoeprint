# ── Variables d'environnement de l'API NestJS ────────────────
# Ne jamais committer ce fichier avec de vraies valeurs.
# Copier en .env pour le développement local ; en production, saisir ces variables sur Render.
# Au démarrage en production, l'API refuse de démarrer si une variable [OBLIGATOIRE] manque
# et signale dans les logs chaque variable [REQUISE AU LANCEMENT] absente.

# ── Serveur ──────────────────────────────────────────────────
# development = synchronize du schéma (base locale UNIQUEMENT, jamais la base de prod)
NODE_ENV=production
PORT=3001
API_PREFIX=api/v1
# [REQUISE AU LANCEMENT] URL publique de l'API (notify_url CinetPay)
BACKEND_URL=https://<api>
# [REQUISE AU LANCEMENT] URL publique de la boutique (CORS, liens des emails, retour paiement)
FRONTEND_URL=https://<votre-domaine>
# [REQUISE AU LANCEMENT] URL publique de l'admin (CORS)
ADMIN_URL=https://admin.<votre-domaine>
# Origines CORS supplémentaires, séparées par des virgules (facultatif)
# ALLOWED_ORIGINS=https://www.<votre-domaine>

# ── Base de données PostgreSQL (Supabase) ────────────────────
# [OBLIGATOIRE] Supabase › Project Settings › Database (pooler : port 6543)
DB_HOST=aws-0-eu-west-3.pooler.supabase.com
DB_PORT=6543
DB_USERNAME=postgres.VOTRE_PROJECT_REF
DB_PASSWORD=
DB_NAME=postgres
DB_SSL=true

# ── JWT ───────────────────────────────────────────────────────
# [OBLIGATOIRE] 32 caractères minimum, deux valeurs différentes :
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# ── Installation du premier administrateur ───────────────────
# [OBLIGATOIRE pour /admin-setup en production] Code à saisir sur la page d'installation.
# Sans lui, la création du premier administrateur est fermée en production.
ADMIN_SETUP_TOKEN=

# ── CinetPay (Orange Money, Moov Money, carte) ───────────────
# [REQUISE AU LANCEMENT] les trois clés (la clé secrète vérifie la signature du webhook)
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
CINETPAY_BASE_URL=https://api-checkout.cinetpay.com/v2

# ── Cloudinary (fichiers clients, visuels) ───────────────────
# [REQUISE AU LANCEMENT]
CLOUDINARY_CLOUD_NAME=dtie3vgyz
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Emails transactionnels (Resend) ──────────────────────────
# [REQUISE AU LANCEMENT] Sans clé, les emails sont seulement simulés (journal « simulated » dans l'admin).
# Le domaine d'EMAIL_FROM doit être vérifié sur Resend (enregistrements DNS SPF/DKIM).
RESEND_API_KEY=
EMAIL_FROM=YopoePrint <noreply@<votre-domaine>>

# ── Connexion avec Google (Google Identity Services) ─────────
# [REQUISE AU LANCEMENT si le bouton Google est affiché] Identifiant client OAuth « Application Web ».
# Même valeur que NEXT_PUBLIC_GOOGLE_CLIENT_ID côté boutique.
GOOGLE_CLIENT_ID=

# ── Limitation de débit (facultatif) ─────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100
# Nombre de proxys devant l'API (Render = 1, valeur par défaut en production)
# TRUST_PROXY=1
